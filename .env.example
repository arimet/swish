# --- Admin access (client) ---
# Password required to add data and start a match. Defaults to "admin".
VITE_ADMIN_PASSWORD=admin

# --- Demo data (optional) ---
# Seeds demo teams/championship/matches, also in production (e.g. Vercel).
# Leave empty for real use. In development the seed always runs.
VITE_SEED=

# --- Cross-device sharing + spectator following (optional) ---
# Empty = fully local app (no network calls, same-device following only).
# On Vercel, set "/api" to enable shared data and the realtime (SSE) stream.
VITE_SYNC_URL=

# --- Server: Redis store (Vercel KV / Upstash), required when VITE_SYNC_URL is set ---
# The Vercel KV integration fills in KV_REST_API_URL / KV_REST_API_TOKEN automatically.
# Otherwise (Upstash direct): UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=
