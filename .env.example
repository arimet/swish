# --- Access codes (client) ---
# Three independent codes. Each one is optional: when a variable is left empty,
# the development fallback shown below applies IN PRODUCTION TOO — set all three
# for a real deployment, not just the admin one.
#
# Admin: manage the roster, schedule matches, call up players, plan trainings,
# enter championship results, correct stats after the game. Fallback: "admin".
VITE_ADMIN_PASSWORD=admin
# Scorer's table: start a match, score, fouls, substitutions, clock, and
# "finish the match" — which freezes the score for good. Fallback: "marque".
VITE_SCORER_PASSWORD=marque
# Player: grants NO write access at all. It only unlocks picking your own name
# in the roster, so the app can show you your stats. Fallback: "joueur".
VITE_PLAYER_PASSWORD=joueur
#
# These codes are compiled into the bundle and readable in the browser's dev
# tools, and `api/mutate.ts` / `api/match/[id].ts` accept writes with no
# authentication at all. The three accesses guard against accidents between
# people who trust each other, not against a malicious third party.

# --- Demo data (optional) ---
# Seeds demo teams/championship/matches, also in production (e.g. Vercel).
# Leave empty for real use. In development the seed always runs.
VITE_SEED=

# --- Cross-device sharing + spectator following (optional) ---
# Empty = fully local app (no network calls, same-device following only).
# On Vercel, set "/api" to enable shared data and the realtime (SSE) stream.
VITE_SYNC_URL=

# --- Server: the database, required when VITE_SYNC_URL is set ---
# The source of truth. Vercel's Neon integration fills DATABASE_URL in for you;
# use the POOLED connection string (its host ends in `-pooler`), because a
# serverless function holds no connection between invocations.
# Locally: `docker compose up -d` then
#   psql "postgres://swish:swish@localhost:5433/swish" -f db/schema.sql
DATABASE_URL=

# Guards every read and write of club data. NOT prefixed VITE_ — unlike the three
# codes above, this one must never reach the bundle: it is checked by the server,
# not by the client. Any long random string. Each device enters it once, under
# Administration → Synchronisation.
# The API refuses to serve while this is empty. That is deliberate: a configured
# database with no token would be open to anyone who knows the URL.
SYNC_WRITE_TOKEN=
