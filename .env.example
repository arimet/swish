# --- Accès administrateur (client) ---
# Mot de passe requis pour ajouter des infos et démarrer une rencontre.
# Par défaut « admin » si non défini.
VITE_ADMIN_PASSWORD=admin

# --- Données de démo (optionnel) ---
# Met des équipes/championnat/matchs de démo aussi en production (ex. Vercel).
# Laisser vide en usage réel. En développement le seed est toujours actif.
VITE_SEED=

# --- Suivi spectateur multi-appareils (optionnel) ---
# Laisser vide = app 100 % locale (aucun appel réseau, suivi same-device only).
# Sur Vercel, mettre "/api" pour activer la synchro temps réel (SSE).
VITE_SYNC_URL=

# --- Serveur : store Redis (Vercel KV / Upstash), requis si VITE_SYNC_URL est défini ---
# L'intégration Vercel KV renseigne KV_REST_API_URL / KV_REST_API_TOKEN automatiquement.
# Sinon (Upstash direct) : UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=
