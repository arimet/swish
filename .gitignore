node_modules/
dist/
dist-ssr/
*.local
.DS_Store

# Local development secrets: `DATABASE_URL` and above all `SYNC_WRITE_TOKEN`,
# which guards writes to the club's database. `.env.example` documents the
# variables, it does not contain them.
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Superpowers planning docs (kept out of the repo)
docs/superpowers/

# Local settings for the design review tool. `*.local` above does not catch them:
# the file is named `config.local.json`, and the pattern wants a name that *ends*
# in ".local".
#
# The folder's contents, not the folder itself (`.impeccable/` with the trailing
# slash): git does not descend into an excluded directory, so no negation could
# then re-include a file inside it.
.impeccable/*
# Because the charter's sidecar is a **shared** artifact — like the DESIGN.md it
# extends (tonal ramps, motion tokens, component excerpts). The rest of the folder
# is cache and machine preference.
!.impeccable/design.json
