{
  // Les fonctions serverless d'`api/`.
  //
  // Elles n'étaient dans AUCUN projet : `tsconfig.app` ne prend que `src`,
  // `tsconfig.node` que `vite.config.ts`. Elles n'ont donc jamais été typées,
  // et une erreur ne se serait manifestée qu'au déploiement — c'est-à-dire sur
  // la seule partie du code qui touche la source de vérité.
  //
  // Réglages de Vercel, pas ceux du navigateur : pas de `lib` DOM, résolution
  // `nodenext` (d'où les imports en `.js`), et les types de Node.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
